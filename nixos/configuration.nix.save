# Edit this configuration file to define what should be installed on
# your system.  Help is available in the configuration.nix(5) man page
# and in the NixOS manual (accessible by running ‘nixos-help’).

{ config, pkgs, ...}: 
{
programs.niri.enable = true;

# bluetooth
hardware.bluetooth.enable = true;
hardware.bluetooth.powerOnBoot = true;

# sound
security.rtkit.enable = true;
services.pipewire = {
  enable = true;
  alsa.enable = true;
  alsa.support32Bit = true;
  pulse.enable = true;
  jack.enable = true;
  wireplumber.enable = true;
};

# MPD (Music)
environment.etc."xdg/mpd/mpd.conf".text = ''
    music_directory    "/home/valtrynx/Music"
    playlist_directory "/home/valtrynx/.config/mpd/playlists"
    db_file            "/home/valtrynx/.config/mpd/database"
    pid_file           "/home/valtrynx/.config/mpd/pid"
    state_file         "/home/valtrynx/.config/mpd/state"
    sticker_file       "/home/valtrynx/.config/mpd/sticker.sql"

    audio_output {
        type            "pipewire"
        name            "PipeWire Sound Server"
     }
  '';

  systemd.user.services.mpd = {
    enable = true;
    description = "Music Player Daemon";
    wantedBy = [ "default.target" ];
    serviceConfig = {
      ExecStart = "${pkgs.mpd}/bin/mpd --no-daemon /etc/xdg/mpd/mpd.conf";
    };
  };

  systemd.user.tmpfiles.rules = [
    "d /home/valtrynx/Music 0755 valtrynx users -"
    "d /home/valtrynx/.config/mpd/playlists 0755 valtrynx users -"
  ];

# flatpak 
services.flatpak.enable = true;

# mullvad-vpn
services.mullvad-vpn.enable = true;

security.polkit.enable = true;

# packages
environment.systemPackages = with pkgs; [
   alacritty
   fuzzel
   xwayland-satellite
   fastfetch
   firefox
   mullvad-vpn
   vicinae
   blueman
   pavucontrol
   wireplumber
   mpd
   rmpc
   telegram-desktop
   yazi
   yt-dlp
   neovim
   awwwn
];

# aliases
environment.shellAliases = {
  download = "yt-dlp -f bestaudio -x --audio-format mp3 --audio-quality 0 -o '~/Music/%(title)s.%(ext)s'";
  niriconf = "nvim ~/.config/niri/config.kdl";
  wayconf = "cd ~/.config/waybar/";
  ffconf = "nvim ~/.config/fastfetch/config.jsonc";
};
	
  imports =
    [ # Include the results of the hardware scan.
      ./hardware-configuration.nix
    ];

  nix.settings.experimental-features = ["nix-command" "flakes"];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  boot.kernelPackages = pkgs.linuxPackages_latest;

  networking.hostName = "nixos"; # Define your hostname.

  networking.networkmanager.enable = true;

  time.timeZone = "Europe/Minsk";

  i18n.defaultLocale = "ru_RU.UTF-8";

  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };
  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
  };
  environment.localBinInPath = true;
    environment.variables = {
    XDG_DATA_DIRS = [
      "$HOME/.local/share/flatpak/exports/share"
      "/var/lib/flatpak/exports/share"
    ];
  };

  users.users."valtrynx" = {
    isNormalUser = true;
    description = "valtrynx";
    extraGroups = [ "networkmanager" "wheel" ];
    packages = with pkgs; [];
  };

  nixpkgs.config.allowUnfree = true;

  system.stateVersion = "26.05"; # Did you read the comment?

}
