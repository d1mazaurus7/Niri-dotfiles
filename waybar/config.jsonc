{
    "height": 50,
    "spacing": 4,
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": [
        "niri/workspaces",
        "mpd"
    ],
    "modules-center": [
        "niri/window",
        "clock",
        "custom/browser",
        "custom/cmd",
        "custom/telegram",
        "custom/freetube",
        "custom/rmpc",
        "custom/nvim",
        "custom/yazi"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "niri/language",
        "tray"
    ],
    "mpd": {
        "format": "{artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "Stopped ",
        "interval": 5
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "interval": 2,
        "format": "CPU: {usage}% ",
        "tooltip": false
    },
    "memory": {
        "interval": 2,
        "format": "RAM: {used:0.1f}G / {total:0.1f}G "
    },
    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} {gwaddr}",
        "format-disconnected": "Disconnected 󰖪"
    },
    "pulseaudio": {
        "format": "{volume}% {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-source": "{volume}% ",
        "on-click": "pavucontrol"
    },
    "custom/browser": {
        "format": "󰈹",
        "on-click": "command -v firefox >/dev/null && firefox || notify-send 'Firefox is not installed'"
    },
    "custom/cmd": {
        "format": "",
        "on-click": "command -v alacritty >/dev/null && alacritty || notify-send 'Alacritty is not installed'" 
    },
    "custom/telegram": {
        "format": "",
        "on-click": "command -v Telegram >/dev/null && Telegram || notify-send 'Telegram is not installed'"
    },
    "custom/freetube": {
        "format": "",
        "on-click": "command -v freetube >/dev/null && freetube || notify-send 'FreeTube is not installed'"
    },
    "custom/rmpc": {
        "format": "󰎄",
        "on-click": "command -v rmpc >/dev/null && alacritty -e rmpc || notify-send 'rmpc is not installed'"
    },
    "custom/nvim": {
        "format": "",
        "on-click": "command -v nvim >/dev/null && alacritty -e nvim || notify-send 'Neovim is not installed'"
    },
    "custom/yazi": {
        "format": "",
        "on-click": "command -v yazi >/dev/null && alacritty -e yazi || notify-send 'Yazi is not installed'"
    }

}
