configuration {
  modi: "drun";
  display-drun: "";
  show-icons: true;
  drun-display-format: "{icon}  {name}";
  font: "JetBrains Mono 14";
}

@theme "/dev/null"
@import "colors.rasi"
* {
  border-radius: 0.0em;
  background-color: @bg;
  text-color: @fg;
}

window {
  location: center;
  border: 3px;
  border-radius: 0px;
  border-color: @border;
  width: 25%;
  spacing: 0;
  children: [ box ];
}

box {
  padding: 0.5em;
  spacing: 0.5em;
  children: [ entry, listview ];
}

entry {
  placeholder: "Search...";
  placeholder-color: @al;
  padding: 0.75em;
  expand: false;
}

element {
  text-color: @al;
  padding: 0.4em;
}
element selected {
  text-color: @fg;
}
element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}

listview {
  lines: 10;    
}

listview, element, element selected, element-text, element-icon {
  cursor: pointer;
}
