{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#e8e78f",
      "2": "#616118",
      "3": "#cac8a5",
      "4": "#e8e78f",
      "5": "#e6e3d5"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "separator": "#e2e2e9"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}"
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#cbcb76"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#cac8a5"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#e6e4bf"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#a4d0bd"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

