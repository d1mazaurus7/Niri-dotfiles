animations {
    slowdown 1.5
    workspace-switch {
        spring damping-ratio=0.6 stiffness=350 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.6 stiffness=350 epsilon=0.0001
    }
    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }
    window-close {
        duration-ms 300
        curve "ease-out-quad"
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=350 epsilon=0.00001
    }
    window-resize {
        spring damping-ratio=0.5 stiffness=350 epsilon=0.001
    }
    config-notification-open-close {
        duration-ms 400
        curve "ease-out-cubic"
    }
    screenshot-ui-open {
        duration-ms 350
        curve "ease-out-cubic"
    }
    overview-open-close {
        spring damping-ratio=0.6 stiffness=350 epsilon=0.0001
    }
}
