{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "{{colors.on_primary_container.default.hex}}",
      "2": "{{colors.inverse_primary.default.hex}}",
      "3": "{{colors.secondary.default.hex}}",
      "4": "{{colors.on_primary_container.default.hex}}",
      "5": "{{colors.on_surface.default.hex}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "separator": "#e2e2e9"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}"
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "{{colors.secondary_fixed.default.hex}}"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

